# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your local MongoDB URI or MongoDB Atlas connection string:
# Example local: mongodb://127.0.0.1:27017/worldly
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/worldly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/worldly

# JWT Secret for Authentication Token Signing
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

